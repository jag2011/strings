# Settings for stringsd, read by deploy/strings.service from
# /etc/strings/strings.env. Keep that file root-only, it holds secrets:
#
#   sudo install -m 600 strings.env.example /etc/strings/strings.env
#   sudo systemctl restart strings
#
# stringsd itself doesn't read .env files; for local runs, export the
# variables in your shell.

# Sign-in links from an external account server (see README). Set all three
# or none; stringsd refuses to start with only some of them.
#STRINGS_AUTH_URL=https://api.example.com/w/redeem
#STRINGS_AUTH_SECRET=
#STRINGS_AUTH_NAME=My App

# AI translation (Admin → AI) through OpenRouter. Without a key the AI page
# explains what's missing.
#OPENROUTER_API_KEY=sk-or-...

# Already set in strings.service; uncomment to override.
#STRINGS_ADDR=:8080
#STRINGS_DB=/var/lib/strings/strings.db
#STRINGS_BASE=/strings
#STRINGS_TRUST_PROXY=1
